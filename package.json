{
  "name": "skippidy-skip",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:playable:skip": "vite --config vite.playable-skip.config.js",
    "dev:playable:craft": "vite --config vite.playable-craft.config.js",
    "build": "vite build && cp -r store dist/store && rm -f dist/store/*.md",
    "build:playable": "npm run build:playable:skip && npm run build:playable:craft",
    "build:playable:skip": "node scripts/build-playable-skip.mjs",
    "build:playable:craft": "node scripts/build-playable-craft.mjs",
    "bake:fish": "node scripts/bake-fish.mjs",
    "bake:nature": "node scripts/bake-nature.mjs",
    "preview": "vite preview --port 8741",
    "test": "node scripts/mc-selftest.mjs && node scripts/rock-selftest.mjs && node scripts/check-career.mjs",
    "start": "vite"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "appsflyer-capacitor-plugin": "^6.18.0",
    "peerjs": "1.5.4",
    "posthog-js": "^1.407.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "playable-kit": "file:vendor/playable-kit-1.0.0.tgz",
    "vite": "^8.1.5"
  }
}
